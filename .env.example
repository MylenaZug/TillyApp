# Auth.js
# Fuer lokale Entwicklung optional: Ohne diese Werte funktioniert nur der
# "Dev-Login"-Button (siehe DEV_USER_EMAIL), Google-Login bleibt dann deaktiviert.
AUTH_SECRET=
# In Production hinter Apache/Reverse Proxy auf true setzen
AUTH_TRUST_HOST=false
# In Production: öffentliche URL der App, ohne /api/auth
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur diese Google-Konten duerfen sich anmelden (Komma-getrennt)
ALLOWED_GOOGLE_EMAILS=husband@gmail.com,wife@gmail.com

# Nur außerhalb von Production aktiv: E-Mail, mit der der "Dev-Login"-Button
# anmeldet, ganz ohne Google-OAuth. Default: dev@localhost
DEV_USER_EMAIL=dev@localhost

# Optionale Anzeigenamen als JSON-Map
USER_DISPLAY_NAMES={"husband@gmail.com":"Jones","wife@gmail.com":"Svenja"}

# SQLite-Datenbankdatei
DB_PATH=./tilly.db
